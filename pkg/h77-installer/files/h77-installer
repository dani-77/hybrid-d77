#!/bin/sh
# hybrid-d77 :: thin wrapper around chimera-installer (h77-install-scripts'
# own patched build, see pkg/h77-install-scripts/template.py), pre-loaded
# with this project's defaults (see /etc/h77/installer.conf). Needs root --
# run via doas (opendoas is Chimera's own default, part of base-full-misc;
# there is no `sudo` package in this image unless someone adds one).
#
# The groups/services gaps this used to paper over with a post-install
# fix-up (files/post-install) are now handled by chimera-installer
# itself -- a real, interactive checklist for both, patched directly
# into h77-install-scripts. Not auto-run from here anymore: doing both
# would mean the fix-up unconditionally re-applying this project's own
# defaults even if someone explicitly unchecked something in the new
# interactive dialogs, silently overriding their choice. It's still
# installed at /usr/lib/h77-installer/post-install as a manual fallback
# (e.g. for a network-source install where those dialogs weren't shown
# the same way, or to reapply after the fact) -- see that file's own
# header comment.
#
# 2026-09-13: chimera-installer's own custom Partition/Filesystems
# steps (menu_hybrid_partition/menu_hybrid_filesystems) were reverted
# after real hardware testing (see h77-install-scripts' own
# template.py) -- partitioning/formatting/mounting is manual again,
# plain upstream convention. User's own suggestion: put a clear
# reminder right before the installer itself launches, not just in
# motd (easy to have scrolled past by the time someone actually runs
# this), so it's the last thing seen before SystemRoot asks for a
# path. `dialog` is already a hard package dependency of this image
# (see mklive-image.sh's sway PKGS).
dialog --colors --no-shadow --backtitle "Hybrid D77 installer" \
    --title "Before you start" --msgbox \
    "Partition and format the target disk by hand first (cfdisk/fdisk + mkfs), \
then mount it all under /mnt/root -- the root filesystem AT /mnt/root \
itself, anything else (e.g. an EFI system partition) under \
/mnt/root/<path>. UEFI needs a FAT32 ESP; BIOS/MBR needs none. \
SystemRoot, later in this installer, expects exactly /mnt/root." \
    12 74

# 2026-09-13, same day: real hardware report -- the Groups/Services
# checklists (both real, unmodified patches, confirmed by re-reading
# the source and the git diff of every recent commit) appeared to be
# "desligados" (turned off). Root cause, found by the user directly:
# upstream chimera-installer's own FIRST screen asks "Do you wish to
# fetch and run the latest available version? (needs network)?" --
# answering yes does a real `fetch` of the pristine, unmodified
# chimera-installer straight from
# raw.githubusercontent.com/chimera-linux/chimera-install-scripts and
# re-execs INTO IT (`exec /bin/sh "$INSTALLER_FILE"`), completely
# discarding every one of this project's own patches (Groups,
# Services, the reminder above, the title rename, all of it) for the
# rest of that run. Upstream already provides the fix for exactly this
# case: if $SKIP_UPDATE_CHECK is non-empty, that whole prompt is
# skipped outright (confirmed in chimera-installer's own source, right
# before the "entry point" section) -- no need to patch the check
# itself, just set the env var here so our own wrapper never offers to
# self-replace with vanilla upstream.
export SKIP_UPDATE_CHECK=1

exec chimera-installer -c /etc/h77/installer.conf "$@"
