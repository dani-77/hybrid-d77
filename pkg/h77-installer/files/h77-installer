#!/bin/sh
# hybrid-d77 :: thin wrapper around chimera-installer (h77-install-scripts'
# own patched build, see pkg/h77-install-scripts/template.py), pre-loaded
# with this project's defaults (see /etc/h77/installer.conf). Needs root --
# run via doas (opendoas is Chimera's own default, part of base-full-misc;
# there is no `sudo` package in this image unless someone adds one).
#
# The groups/services gaps this used to paper over with a post-install
# fix-up (files/post-install) are now handled by chimera-installer
# itself -- a real, interactive checklist for both, patched directly
# into h77-install-scripts. Not auto-run from here anymore: doing both
# would mean the fix-up unconditionally re-applying this project's own
# defaults even if someone explicitly unchecked something in the new
# interactive dialogs, silently overriding their choice. It's still
# installed at /usr/lib/h77-installer/post-install as a manual fallback
# (e.g. for a network-source install where those dialogs weren't shown
# the same way, or to reapply after the fact) -- see that file's own
# header comment.
exec chimera-installer -c /etc/h77/installer.conf "$@"
